{
  "name": "spotlight-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private opportunity console: turns an actress's Gmail into tracked career opportunities.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "node scripts/migrate.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:schema": "bash db/tests/schema_test.sh",
    "typecheck": "tsc --noEmit",
    "gen:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "vercel-build": "npm run migrate && next build"
  },
  "dependencies": {
    "next": "^16.0.0",
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
