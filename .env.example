# Copy to .env.local for local development. Never commit real values.

# Public address of the web app, no trailing slash.
# Local: http://localhost:3000   Production: https://your-domain
APP_URL=http://localhost:3000

# Postgres connection string. Supabase: Connect > Direct > "Transaction pooler" (port 6543).
# Don't use the session pooler (5432) on Vercel: it allows only 15 held connections.
DATABASE_URL=postgresql://postgres:password@localhost:5432/spotlight

# Recommended in production: the database's CA certificate (PEM) so the
# server certificate is verified. Supabase: Database settings > SSL.
# DATABASE_CA_CERT=

# Who can sign in: the two admin Google accounts, comma-separated.
ADMIN_EMAILS=manager@example.com,actress@example.com

# Google OAuth web client (Google Cloud > APIs & Services > Credentials).
# Authorised redirect URI to add there: {APP_URL}/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs session cookies. Generate with: npm run gen:secret
SESSION_SECRET=

# Encrypts Gmail tokens stored in the database (32 bytes, base64).
# Generate with: npm run gen:secret  (a different value from SESSION_SECRET)
TOKEN_ENCRYPTION_KEY=

# Shared secret that Supabase's scheduler sends to /api/cron/tick every minute.
# Generate with: npm run gen:secret  (its own value; at least 32 characters)
CRON_SECRET=

# AI sorting (Claude API). Without a key, emails are stored but not sorted.
# Create one at console.anthropic.com > Settings > API keys.
ANTHROPIC_API_KEY=
# Optional: override the models (defaults: claude-haiku-5-5 for triage, claude-sonnet-5-5 for extraction).
# ANTHROPIC_TRIAGE_MODEL=
# ANTHROPIC_EXTRACT_MODEL=
